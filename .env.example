# Server port
PORT=3000

# Secret used to sign login sessions (JWT). Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Optional: enables the full conversational AI Chemistry Tutor.
# Without this, the Tutor falls back to an offline rule-based mode using the built-in
# reaction library and periodic table data.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model the AI Tutor uses (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
